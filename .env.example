# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Connection (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/humanizer_db"

# JWT Authentication
JWT_SECRET="dev-jwt-super-secret-key-with-minimum-32-characters-length"
JWT_EXPIRES_IN="7d"

# Storage Configuration
STORAGE_PATH="./uploads"
MAX_FILE_SIZE_BYTES=26214400

# NVIDIA Multi-Model AI Infrastructure (ONLY AI Provider)
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
USE_MOCK_NVIDIA=false

# Default NVIDIA Model Role Assignments (Discoverable & Configurable)
NVIDIA_CLASSIFIER_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_GENERAL_WRITER_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_MEDICAL_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_SCIENTIFIC_MODEL=mistralai/mistral-large-2-instruct
NVIDIA_LEGAL_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_TECHNICAL_MODEL=deepseek-ai/deepseek-r1
NVIDIA_NATURALNESS_EVALUATOR_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_MEANING_EVALUATOR_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_FACT_EVALUATOR_MODEL=deepseek-ai/deepseek-r1
NVIDIA_REFINEMENT_MODEL=mistralai/mistral-large-2-instruct

# Humanization Quality Engine Limits
MAX_ITERATIONS=5
CANDIDATE_COUNT=3
QUALITY_TARGET=80
MIN_MEANING_PRESERVATION=85
MIN_FACTUAL_CONSISTENCY=85
MIN_TERMINOLOGY_SCORE=80
MIN_CITATION_SCORE=90

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
